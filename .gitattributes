# 统一换行符，避免 Windows / Linux 差异导致的无意义 diff
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary

# 锁文件不参与 diff 统计（但仍入库）
package-lock.json -diff linguist-generated
pnpm-lock.yaml    -diff linguist-generated
