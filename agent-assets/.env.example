# 复制到仓库根目录的 .env（该文件不入库），或在启动进程前导出这些变量。
#
# DSH_HOME 属于 bootstrap-only 变量，**不能**写进任何 .env，必须在启动进程前设置。
# 它决定 profile、会话、设置、凭据的落盘位置；每个 dsh 实例一份。

# DSH 运行时目录。局部联调时指向仓库内被 Git 忽略的 _runtime/，交付时由编排服务分配。
# DSH_HOME=

# 预设资产的绝对路径。不设置时回退成"从仓库根启动"的 agent-assets/agent-presets。
# AGENT_ASSETS_ROOT=

# 业务工具（MCP）接入。URL 指向业务系统；密钥与上下文由部署环境或编排服务注入。
AGENT_MCP_URL=http://localhost:8090/api/v1/agent/mcp
AGENT_MCP_TOOL_KEY=
AGENT_MCP_CONTEXT_ID=
