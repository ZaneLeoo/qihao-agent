# 复制到运行 `pnpm web qihao-agent` 的 deepseek-harness 根目录的 .env（该文件不入库）。
# 这些值供当前联调使用；生产环境改由编排服务和登录态注入。
#
# DSH_HOME 属于 bootstrap-only 变量，**不能**写进任何 .env，必须在启动进程前设置。
# 它决定 profile、会话、设置、凭据的落盘位置；每个 dsh 实例一份。

# 预设资产的绝对路径。
AGENT_ASSETS_ROOT=C:\Work\Code\Agent\agent-new\agent-assets\agent-presets

# 从 DSH 目录启动时无需设置；从 agent-new 等其他目录启动时填写 DSH 构建目录。
# AGENT_DSH_ROOT=C:\Work\Code\AI\deepseek-harness

# Web 服务端口；不设置时为 3099。
AGENT_DSH_WEB_PORT=3099

# 模型服务凭据。若当前 web profile 已通过 DSH 凭据库配置，可留空。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# 业务工具（MCP）接入。指到 MOM 后端（aoliya-mom-api，默认端口 9991），
# 不是本平台的 Spring Boot 后端（8090，那个没有 MCP 端点）。
# 工具密钥必须与 MOM 后端配置一致。
AGENT_MCP_URL=http://localhost:9991/api/v1/agent/mcp2
AGENT_MCP_TOOL_KEY=
# 临时联调可填后端签发的有效上下文 ID。它约 30 分钟过期，不能随意编造；
# 后续接入登录态后由会话启动流程自动替换，不再手填。
AGENT_MCP_CONTEXT_ID=

# 二维码/条码图片上传地址。未设置时使用 MOM 后端的本地默认地址。
# AGENT_IMAGE_UPLOAD_URL=http://localhost:9991/api/v1/agent/tools/images/upload
